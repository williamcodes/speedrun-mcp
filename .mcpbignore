*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pre-commit-config.yaml
.tool-versions
.env
.env.*
.speedrun-mcp-key
uv.lock
server.json
glama.json
.mcpbignore
*.mcpb
.DS_Store
.idea/
.vscode/
