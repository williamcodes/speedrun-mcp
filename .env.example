# Copy this file to .env for local configuration.
# The server reads exported variables; it does not load .env automatically.
# See the README for loading instructions.

# Optional API key. Leave empty to use the public read tools without an account.
SPEEDRUN_API_KEY=

# Set to 1 to enable run submission and moderation. Requires SPEEDRUN_API_KEY.
# With 0, authenticated tools remain read-only.
SPEEDRUN_ENABLE_WRITES=0
